; Copy to /etc/recordings-email/config.ini and chmod 600 (holds the KAZOO API
; key and SMTP credentials). All values shown are examples.

[server]
listen_host = 127.0.0.1
listen_port = 8080
; must match the path in the webhook URI configured by the Monster UI app
path = /recordings-email

[kazoo]
; base URL of the KAZOO crossbar API, including the version segment
api_base = https://kazoo.example.com:8443/v2
; account API key (Account Settings -> API key in SmartPBX, or `sup`)
api_key = REPLACE_WITH_ACCOUNT_API_KEY
; With S3/external storage the audio is uploaded just after the webhook fires,
; so the media can 404 for a few seconds. Retry the download this many times,
; waiting this many seconds between tries, before giving up.
;download_retries = 6
;download_retry_delay = 5.0

[email]
; default recipient if the webhook custom_data does not carry one
to = archive@example.com
from = recordings@example.com
subject_prefix = New call recording

[smtp]
host = smtp.example.com
port = 587
; username and password are optional
;username = recordings@example.com
;password = REPLACE_WITH_SMTP_PASSWORD
; true => STARTTLS on submission ports, or implicit TLS when port = 465
use_tls = true

[security]
; Shared secret echoed back in the webhook body; the receiver rejects requests
token = REPLACE_WITH_SHARED_SECRET
; Optional comma-separated allowlist of source IPs (the KAZOO cluster nodes).
; When set, requests from any other peer are rejected with 403. Leave blank to
; allow all.
allowed_ips =
